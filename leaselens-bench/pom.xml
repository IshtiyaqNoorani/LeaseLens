<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.leaselens</groupId>
        <artifactId>leaselens-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>leaselens-bench</artifactId>
    <name>LeaseLens Benchmarks</name>
    <description>Benchmark harness: assessed algorithms vs baselines; writes benchmarks/results/*.csv</description>

    <dependencies>
        <dependency>
            <groupId>com.leaselens</groupId>
            <artifactId>leaselens-algorithms</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>leaselens-bench</finalName>
        <plugins>
            <plugin>
                <!-- Self-contained runnable jar (bench classes + the algorithms module). -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Separate file: the module's normal jar stays thin for use by the API. -->
                            <outputFile>${project.build.directory}/leaselens-bench-cli.jar</outputFile>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.leaselens.bench.BenchmarkCli</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.leaselens.bench.BenchmarkCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
