<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.leaselens</groupId>
        <artifactId>leaselens-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>leaselens-api</artifactId>
    <name>LeaseLens API</name>
    <description>Spring Boot REST API: ingestion, validation, analytics services</description>

    <dependencies>
        <dependency>
            <groupId>com.leaselens</groupId>
            <artifactId>leaselens-algorithms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.leaselens</groupId>
            <artifactId>leaselens-data</artifactId>
        </dependency>
        <dependency>
            <!-- Benchmark harness and baselines, for the Algorithm Lab's bounded live runs. -->
            <groupId>com.leaselens</groupId>
            <artifactId>leaselens-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>leaselens-api</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Bundle the committed datasets so "load sample" works from any working directory. -->
            <resource>
                <directory>../data/sample</directory>
                <targetPath>datasets/sample</targetPath>
                <includes><include>*.csv</include></includes>
            </resource>
            <resource>
                <directory>../benchmarks/results</directory>
                <targetPath>benchmarks</targetPath>
                <includes><include>*.csv</include></includes>
            </resource>
            <resource>
                <directory>../data/golden</directory>
                <targetPath>datasets/golden</targetPath>
                <includes><include>*.csv</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
