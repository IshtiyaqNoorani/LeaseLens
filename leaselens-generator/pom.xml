<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.leaselens</groupId>
        <artifactId>leaselens-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>leaselens-generator</artifactId>
    <name>LeaseLens Synthetic Data Generator</name>
    <description>Seeded, reproducible synthetic portfolio data (CSV). Not an assessed algorithm.</description>

    <dependencies>
        <dependency>
            <!-- Test only: checks that generated data passes the real validation rules. -->
            <groupId>com.leaselens</groupId>
            <artifactId>leaselens-data</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>leaselens-generator</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.leaselens.generator.GeneratorCli</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.leaselens.generator.GeneratorCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
